    "@next/mdx": "^16.4.3",
    "@supabase/supabase-js": "^2.118.0",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-fade": "^8.6.0",
